{
    "browser_specific_settings": {
      "gecko": {
        "id": "@fto-AOTYTM",
        "data_collection_permissions": {
            "required": ["none"]
        }
      }
    },
    "name": "AOTY-YTM",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": ["scripting"],
    "content_scripts": [
        {
            "js": ["main.js"],
            "matches": ["https://www.albumoftheyear.org/album/*"]
        }
    ],
    "action": {
        "default_icon": "logo.png",
        "default_title": "AOTYTM"
    }
}